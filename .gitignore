# Flutter/Dart
.dart_tool/
.packages
build/
dist/

# Native OS binaries (C++/Rust compiled cores via FFI)
lib/modules/native/*.dll
lib/modules/native/*.so
lib/modules/native/*.dylib

# Platform build outputs
windows/flutter/ephemeral/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/

# Logs and temporary files
logs/
logs/*.log
*.log
assets/temp/

# Local IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated files
*.g.dart
*.freezed.dart

# Personal config / local runtime state - may hold real API keys/secrets
excel_patches.json
dictionary.json
config.ini
config.json

# Packaged release archives
*.7z
*.rar
dist.7z
dist.rar
dist.zip

# Python (helper scripts under assets/scripts)
__pycache__/
*.pyc
venv/
.venv/

# Tooling
.claude/

# Personal shortcuts
*.lnk
